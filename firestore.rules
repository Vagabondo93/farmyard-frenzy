rules_version = '2';
// Regole del database: tutti leggono, ognuno scrive solo il proprio profilo.
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /nicks/{nick} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // chi è online: ognuno aggiorna solo il proprio segnale
    match /presence/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // richieste di amicizia, inviti e coda della partita rapida: le scrive anche l'altro giocatore
    match /friendReq/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /invites/{uid} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /queue/{uid} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /rooms/{code} {
      allow read: if true;
      allow write: if request.auth != null;
      match /{sub=**} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }
  }
}
