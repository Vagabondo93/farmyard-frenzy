rules_version = '2';
// Regole del database: tutti leggono, ognuno scrive solo il proprio profilo.
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /nicks/{nick} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /rooms/{code} {
      allow read: if true;
      allow write: if request.auth != null;
      match /{sub=**} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }
  }
}
